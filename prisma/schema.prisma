// Prisma schema for Computer Repair Management System
// Database: PostgreSQL (Neon compatible)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TECHNICIAN
}

enum ComputerStatus {
  NORMAL
  REPAIR
  DAMAGED
  RETIRED
  LOST
}

enum RepairStatus {
  WAITING
  ASSIGNED
  DIAGNOSING
  REPAIRING
  WAITING_PART
  COMPLETED
  RETURNED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProblemType {
  Hardware
  Software
  Network
  Windows
  Printer
  Virus_Malware @map("Virus / Malware")
  Other
}

model User {
  id           String      @id @default(uuid())
  username     String      @unique
  email        String      @unique
  password     String
  name         String
  role         Role        @default(TECHNICIAN)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  assignedRepairs Repair[] @relation("TechnicianRepairs")

  @@map("users")
}

model Department {
  id          String     @id @default(uuid())
  code        String     @unique
  name        String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  users     User[]
  computers Computer[]
  repairs   Repair[]

  @@map("departments")
}

model Computer {
  id              String         @id @default(uuid())
  assetCode       String         @unique
  serialNumber    String         @unique
  computerName    String
  brand           String
  model           String
  cpu             String
  ram             String
  storage         String
  operatingSystem String
  ipAddress       String?
  macAddress      String?
  departmentId    String
  department      Department     @relation(fields: [departmentId], references: [id])
  location        String
  assignedUser    String
  purchaseDate    DateTime?
  warrantyExpiry  DateTime?
  status          ComputerStatus @default(NORMAL)
  remark          String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  repairs Repair[]

  @@map("computers")
}

model Repair {
  id                 String       @id @default(uuid())
  repairNo           String       @unique
  computerId         String
  computer           Computer     @relation(fields: [computerId], references: [id])
  requesterName      String
  departmentId       String
  department         Department   @relation(fields: [departmentId], references: [id])
  problemType        ProblemType  @default(Hardware)
  problemDescription String
  priority           Priority     @default(MEDIUM)
  technicianId       String?
  technician         User?        @relation("TechnicianRepairs", fields: [technicianId], references: [id])
  receivedAt         DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  returnedAt         DateTime?
  cause              String?
  solution           String?
  cost               Float        @default(0.0)
  status             RepairStatus @default(WAITING)
  remark             String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  statusHistory RepairStatusHistory[]
  parts         RepairPart[]
  attachments   RepairAttachment[]

  @@map("repairs")
}

model RepairStatusHistory {
  id          String       @id @default(uuid())
  repairId    String
  repair      Repair       @relation(fields: [repairId], references: [id], onDelete: Cascade)
  status      RepairStatus
  description String
  changedBy   String
  createdAt   DateTime     @default(now())

  @@map("repair_status_history")
}

model Part {
  id           String   @id @default(uuid())
  partCode     String   @unique
  name         String
  category     String
  brand        String
  model        String
  stock        Int      @default(0)
  minimumStock Int      @default(5)
  unit         String   @default("pcs")
  price        Float    @default(0.0)
  supplier     String?
  remark       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  repairParts RepairPart[]

  @@map("parts")
}

model RepairPart {
  id        String   @id @default(uuid())
  repairId  String
  repair    Repair   @relation(fields: [repairId], references: [id], onDelete: Cascade)
  partId    String
  part      Part     @relation(fields: [partId], references: [id])
  quantity  Int      @default(1)
  price     Float    @default(0.0)
  total     Float    @default(0.0)
  createdAt DateTime @default(now())

  @@map("repair_parts")
}

model RepairAttachment {
  id        String   @id @default(uuid())
  repairId  String
  repair    Repair   @relation(fields: [repairId], references: [id], onDelete: Cascade)
  fileName  String
  fileUrl   String
  fileType  String
  caption   String?
  createdAt DateTime @default(now())

  @@map("repair_attachments")
}
